{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.local"],
  "tasks": {
    "dev": {
      "cache": false,
      "interactive": true
    },
    "build": {
      "outputs": ["dist/**", ".next/public/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": true,
      "outputs": [".eslintcache"],
      "dependsOn": ["^build"]
    },
    "type-check": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "preview": {
      "cache": false,
      "interactive": true,
      "dependsOn": ["build"]
    },
    "start": {
      "cache": false,
      "interactive": true,
      "dependsOn": ["build"]
    }
  }
}
